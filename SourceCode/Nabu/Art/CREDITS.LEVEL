# Show the first credits screen, followed by others.  Keeps playing the current
# music, which is often the winner's music from the previous player win screen.
# Easter egg left move will show the cottage picture.
GameMode: Trivia
Screen: CREDITS.NFUL
# Use bookmark to go back to credits after displaying Cottage.
LevelBookmark: CREDITS1
LevelNext: All, CREDITS1
LevelNext: Left, COTTAGE
PlayTimeout: 7

